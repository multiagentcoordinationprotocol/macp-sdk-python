{
  "id": "a2a_020_reject_no_envelope_part",
  "op": "envelope_from_a2a_message",
  "description": "A Message whose Parts all have other mediaTypes (here text/plain and application/json) carries no Envelope, so it is not a MACP message at all. RFC-MACP-0014 has no code for that; this is the codec-only NOT_A_MACP_MESSAGE.",
  "input": {
    "message": {
      "messageId": "01JD2A2A0V0TE0000000000003",
      "role": "ROLE_USER",
      "extensions": [
        "https://multiagentcoordinationprotocol.io/a2a/extensions/macp/v1"
      ],
      "parts": [
        {
          "text": "FYI: the fraud model was retrained this morning.",
          "mediaType": "text/plain"
        },
        {
          "mediaType": "application/json",
          "data": {
            "macp_version": "1.0",
            "mode": "macp.mode.decision.v1",
            "message_type": "Vote",
            "message_id": "01JD2A2A0V0TE0000000000003",
            "session_id": "6f1c2a9e-4b7d-4c1e-9a53-2d8f0b7e5a10",
            "sender": "agent://fraud",
            "timestamp": "2026-10-25T09:00:02Z",
            "payload": {
              "proposal_id": "p-1",
              "vote": "APPROVE",
              "reason": "Within risk appetite"
            }
          }
        }
      ],
      "taskId": "6f1c2a9e-4b7d-4c1e-9a53-2d8f0b7e5a10"
    }
  },
  "expected_error": {
    "layer": "codec",
    "code": "NOT_A_MACP_MESSAGE"
  }
}
